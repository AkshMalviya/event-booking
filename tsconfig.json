{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "isolatedModules": true,

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "target": "ES2023",

    "sourceMap": true,
    "outDir": "./dist",

    "incremental": true,
    "skipLibCheck": true,

    "strict": true,
    "strictPropertyInitialization": false,

    "types": ["vitest/globals", "node"],
    "baseUrl": "./",
    "paths": {
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"]
    }
  },

  "files": [],

  "references": [
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/event-service/tsconfig.app.json"
    },
    {
      "path": "./apps/booking-service/tsconfig.app.json"
    }
  ]
}
